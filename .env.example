# Copy to .env (git-ignored) and fill in what you need. Loaded automatically by shared/settings.py.
# Real environment variables win over this file; this file wins over settings.toml.

# ── Vision model (incident card: debris, smoke, driver out, blocking the line) ──
# Needed only when settings.toml [vision] enabled = true. The variable name must match
# vision.api_key_env there (OPENAI_API_KEY for provider = "openai").
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=          # if you switch vision.provider to "anthropic"

# ── Assetto Corsa ──
# Only if AC isn't at the path in settings.toml live.ac_root.
# AC_ROOT=D:/SteamLibrary/steamapps/common/assettocorsa

# ── Fly brain one-off overrides (normally set in settings.toml [flybrain]) ──
# FLYBRAIN_DATA=data/flywire
# FLYBRAIN_MODEL=corrected          # corrected | upstream
# FLYBRAIN_SYNAPSE_STRIDE=1         # 1 = full brain (GPU); 8 = CPU laptop

# ── Use a different settings file (e.g. one per machine) ──
# MARSHAL_SETTINGS=settings.3070.toml
